import socket

HOST = "0.0.0.0"
PORT = 5555

with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind((HOST, PORT))
    s.listen(1)
    print(f"[receiver] ouvindo {HOST}:{PORT}")
    conn, addr = s.accept()
    with conn:
        print("[receiver] conectado por", addr)
        while True:
            data = conn.recv(4096)
            if not data:
                print("[receiver] desconectou")
                break
            print("[receiver] RX:", data.decode("utf-8", errors="replace").strip())
