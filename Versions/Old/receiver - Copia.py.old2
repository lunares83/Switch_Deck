import socket
import subprocess

HOST = "0.0.0.0"
PORT = 5555

# Aqui vai o mapa: id do botão -> comando no Windows
ACTIONS = {
    1: ["cmd", "/c", "notepad"],     # exemplo: abre o Bloco de Notas
    2: ["cmd", "/c", "calc"],        # exemplo: abre a Calculadora
}

def run_action(button_id: int):
    cmd = ACTIONS.get(button_id)
    if not cmd:
        print(f"[receiver] Sem ação cadastrada para id={button_id}")
        return
    print(f"[receiver] Executando id={button_id}: {cmd}")
    subprocess.Popen(cmd)  # não trava o receiver

def handle_line(line: str):
    line = line.strip()
    if not line:
        return

    # Protocolos que vamos usar agora:
    # HELLO_FROM_SWITCH
    # BTN_PRESS 1
    if line.startswith("HELLO"):
        print("[receiver] HELLO ok")
        return

    parts = line.split()
    if len(parts) == 2 and parts[0] == "BTN_PRESS":
        try:
            button_id = int(parts[1])
        except ValueError:
            print("[receiver] BTN_PRESS inválido:", line)
            return
        run_action(button_id)
        return

    print("[receiver] Mensagem desconhecida:", line)

def main():
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s.bind((HOST, PORT))
        s.listen(1)
        print(f"[receiver] ouvindo em {HOST}:{PORT}")

        conn, addr = s.accept()
        with conn:
            print("[receiver] conectado por", addr)

            # Lê como stream de texto linha-por-linha
            f = conn.makefile("r", encoding="utf-8", errors="replace")
            for line in f:
                print("[receiver] RX:", line.strip())
                handle_line(line)

if __name__ == "__main__":
    main()
