import socket
import subprocess

HOST = "0.0.0.0"
PORT = 5555

# id do botão -> comando (lista de args) OU None pra só logar
ACTIONS = {
    1: ["cmd", "/c", "notepad"],
    2: ["cmd", "/c", "calc"],
    3: ["cmd", "/c", "start", "", "https://perplexity.ai"],
    4: ["cmd", "/c", "start", "", "https://google.com"],
    5: ["cmd", "/c", "mmsys.cpl"],  # som do Windows (exemplo)

    # 6..15: por enquanto só loga (você troca depois)
    6: None,
    7: None,
    8: None,
    9: None,
    10: None,
    11: None,
    12: None,
    13: None,
    14: None,
    15: None,
}

def run_action(button_id: int):
    cmd = ACTIONS.get(button_id, None)

    if cmd is None:
        print(f"[receiver] ACTION id={button_id} (sem comando cadastrado)")
        return

    print(f"[receiver] Executando id={button_id}: {cmd}")
    subprocess.Popen(cmd)

def handle_line(line: str):
    line = line.strip()
    if not line:
        return

    if line.startswith("HELLO"):
        print("[receiver] HELLO ok")
        return

    parts = line.split()
    if len(parts) == 2 and parts[0] == "BTN_PRESS":
        try:
            button_id = int(parts[1])
        except ValueError:
            print("[receiver] BTN_PRESS inválido:", line)
            return
        run_action(button_id)
        return

    print("[receiver] Mensagem desconhecida:", line)

def serve_forever():
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s.bind((HOST, PORT))
        s.listen(1)
        print(f"[receiver] ouvindo em {HOST}:{PORT}")

        while True:
            conn, addr = s.accept()
            print("[receiver] conectado por", addr)

            try:
                with conn:
                    f = conn.makefile("r", encoding="utf-8", errors="replace")
                    for line in f:
                        print("[receiver] RX:", line.strip())
                        handle_line(line)
            except Exception as e:
                print("[receiver] erro na conexão:", repr(e))

            print("[receiver] desconectou (voltando a ouvir)")

if __name__ == "__main__":
    serve_forever()
